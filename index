        /* =====================================================================
           BIBBIA EPUB + SCRITTURE SALVATE
           ===================================================================== */
        function matchBookCanon(raw) {
            if (!raw) return null;
            const clean = String(raw).toLowerCase().replace(/[\u00a0\s]+/g, ' ').replace(/[:\-–—].*$/, '').replace(/\d+$/, '').trim();
            for (const b of BIBLE_CANON_66) if (b.aliases.includes(clean)) return b;
            for (const b of BIBLE_CANON_66) if (b.aliases.some(a => a.length >= 4 && clean.startsWith(a + ' '))) return b;
            return null;
        }

        async function parseEpubArchive(arrayBuffer, fileName) {
            const zip = await JSZip.loadAsync(arrayBuffer);
            const keys = Object.keys(zip.files);
            const getEntry = (p) => zip.files[p] || zip.files[keys.find(k => k.toLowerCase() === p.toLowerCase())];
            let opfPath = keys.find(k => k.toLowerCase().endsWith('.opf')) || '';
            const opfDir = opfPath.includes('/') ? opfPath.slice(0, opfPath.lastIndexOf('/')) : '';
            const parser = new DOMParser();
            const opfDoc = parser.parseFromString(await getEntry(opfPath).async('string'), 'application/xml');
            const htmlFiles = [];
            opfDoc.querySelectorAll('manifest > item').forEach(it => {
                const href = it.getAttribute('href') || '';
                const media = it.getAttribute('media-type') || '';
                if (/html|xml/i.test(media) && !/(nav|toc)\./i.test(href)) {
                    const clean = decodeURIComponent(href).split('#')[0];
                    htmlFiles.push(opfDir ? opfDir + '/' + clean : clean);
                }
            });

            const booksMap = {};
            let curBook = 0;
            for (const path of htmlFiles) {
                const entry = getEntry(path);
                if (!entry) continue;
                const doc = parser.parseFromString(await entry.async('string'), 'text/html');
                let bNum = 0;
                const firstV = doc.querySelector('[id^="v"]');
                if (firstV) {
                    const m = (firstV.id || '').match(/^v(\d{2})(\d{3})(\d{3})$/);
                    if (m) bNum = parseInt(m[1], 10);
                }
                if (!bNum) {
                    const h = doc.querySelector('h1, h2, title')?.textContent || '';
                    const mb = matchBookCanon(h);
                    if (mb) bNum = mb.num;
                }
                if (bNum >= 1 && bNum <= 66) curBook = bNum;
                if (curBook < 1 || curBook > 66) continue;

                const canon = BIBLE_CANON_66[curBook - 1];
                if (!booksMap[curBook]) booksMap[curBook] = { num: canon.num, name: canon.name, chaptersByNum: {} };
                const bObj = booksMap[curBook];

                const anchors = Array.from(doc.querySelectorAll('[id]')).filter(el => /^v\d{8}$/.test(el.id) || /^chapter\d+_verse\d+$/i.test(el.id));
                anchors.forEach(el => {
                    let cNum = 1, vNum = 1;
                    const m1 = el.id.match(/^v(\d{2})(\d{3})(\d{3})$/);
                    const m2 = el.id.match(/^chapter(\d+)_verse(\d+)$/i);
                    if (m1) { cNum = parseInt(m1[2], 10); vNum = parseInt(m1[3], 10); }
                    else if (m2) { cNum = parseInt(m2[1], 10); vNum = parseInt(m2[2], 10); }
                    if (!bObj.chaptersByNum[cNum]) bObj.chaptersByNum[cNum] = { num: cNum, verses: [] };
                    const blk = el.closest('p, div.p, li') || el.parentElement;
                    let txt = (blk ? blk.textContent : el.textContent || '').replace(/\s+/g, ' ').trim();
                    txt = txt.replace(new RegExp('^' + vNum + '\\s*'), '').trim();
                    if (txt && !bObj.chaptersByNum[cNum].verses.some(v => v.num === vNum)) {
                        bObj.chaptersByNum[cNum].verses.push({ num: vNum, text: txt });
                    }
                });
            }

            const books = Object.values(booksMap).sort((a, b) => a.num - b.num).map(b => ({
                num: b.num,
                name: b.name,
                chapters: Object.values(b.chaptersByNum).sort((a, c) => a.num - c.num)
                    .map(ch => ({ num: ch.num, verses: ch.verses.sort((x, y) => x.num - y.num) }))
                    .filter(ch => ch.verses.length > 0)
            })).filter(b => b.chapters.length > 0);

            return {
                id: 'bible_epub_archive',
                schemaVersion: EPUB_SCHEMA_VERSION,
                fileName,
                books,
                rawBuffer: arrayBuffer.slice(0),
                currentBookIdx: 0,
                currentChapterIdx: 0,
                fontSizePx: 16
            };
        }

        async function loadSavedBibleArchiveFromIndexedDB() {
            const db = await openStudioDatabase();
            const rec = await new Promise((resolve) => {
                const tx = db.transaction(STORE_BIBLE, 'readonly');
                const req = tx.objectStore(STORE_BIBLE).get('bible_epub_archive');
                req.onsuccess = () => resolve(req.result || null);
                req.onerror = () => resolve(null);
            });
            if (!rec) return;
            loadedBibleArchive = rec;
            if (rec.rawBuffer && rec.schemaVersion !== EPUB_SCHEMA_VERSION) {
                loadedBibleArchive = await parseEpubArchive(rec.rawBuffer, rec.fileName);
                const tx = db.transaction(STORE_BIBLE, 'readwrite');
                tx.objectStore(STORE_BIBLE).put(loadedBibleArchive);
            }
            updateSavedScripturesBadge();
        }

