                const tx = db.transaction(STORE_ANNOTATIONS, 'readonly');
                const req = tx.objectStore(STORE_ANNOTATIONS).getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => resolve([]);
            });
            const allFiles = await new Promise((resolve) => {
                const tx = db.transaction(STORE_FILES, 'readonly');
                const req = tx.objectStore(STORE_FILES).getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => resolve([]);
            });
            const embeddedPdfFiles = [];
            const embeddedAudioFiles = [];
            for (const f of allFiles) {
                if (!f || !f.blob) continue;
                const mime = (f.mimeType || '').toLowerCase();
                const fname = (f.fileName || '').toLowerCase();
                const isPdf = mime.includes('pdf') || fname.endsWith('.pdf');
                const isAudio = mime.startsWith('audio/') || /\.(mp3|m4a|wav|ogg|aac)$/.test(fname);
                if (isPdf && (f.blob.size || 0) <= 40 * 1024 * 1024) {
                    const buf = await f.blob.arrayBuffer();
                    embeddedPdfFiles.push({
                        fileId: f.fileId,
                        fileName: f.fileName || 'documento.pdf',
                        mimeType: f.mimeType || 'application/pdf',
                        base64: arrayBufferToBase64(buf)
                    });
                } else if (isAudio && (f.blob.size || 0) <= 40 * 1024 * 1024) {
                    const buf = await f.blob.arrayBuffer();
                    embeddedAudioFiles.push({
                        fileId: f.fileId,
                        fileName: f.fileName || 'audio.mp3',
                        mimeType: f.mimeType || 'audio/mpeg',
                        base64: arrayBufferToBase64(buf)
                    });
                }
            }
            let embeddedBible = null;
            if (loadedBibleArchive && loadedBibleArchive.rawBuffer && loadedBibleArchive.rawBuffer.byteLength <= 40 * 1024 * 1024) {
                embeddedBible = {
                    fileName: loadedBibleArchive.fileName || 'Bibbia.epub',
                    base64: arrayBufferToBase64(loadedBibleArchive.rawBuffer)
                };
            }

            const payload = {
                app: 'Quaderno per lo studio',
                version: 6,
                exportedAt: new Date().toISOString(),
                homeCards: appState.homeCards,
                sessions: appState.sessions,
                annotations: allAnnotations,
                embeddedPdfFiles,
                embeddedAudioFiles,
                embeddedBible,
                bookmarks: appState.bookmarks,
                savedScriptures: appState.savedScriptures,
                verseComments: appState.verseComments,
                calendarEvents: appState.calendarEvents,
                homeCustomization: appState.homeCustomization,
                windowPrefs: appState.windowPrefs
            };

            const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Quaderno_Studio_v2_Backup_${new Date().toISOString().slice(0, 10)}.json`;
            a.click();
            setTimeout(() => URL.revokeObjectURL(url), 1500);
            if (fb) fb.textContent = `✅ Backup esportato: ${appState.sessions.length} sessioni, ${embeddedPdfFiles.length} PDF, ${embeddedAudioFiles.length} audio, ${appState.calendarEvents.length} appuntamenti, ${appState.savedScriptures.length} scritture.`;
        }

        function handleImportBackupFile(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const fb = document.getElementById('backup-feedback-box');
            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (!Array.isArray(data.sessions)) throw new Error('Struttura non valida');
                    openConfirmModal(
                        'Importa Backup',
                        `Trovate ${data.sessions.length} sessioni e ${Array.isArray(data.calendarEvents) ? data.calendarEvents.length : 0} appuntamenti. Vuoi ripristinare questi dati adesso?`,
                        async () => {
                            const db = await openStudioDatabase();
                            if (Array.isArray(data.homeCards) && data.homeCards.length > 0) appState.homeCards = data.homeCards;
                            appState.sessions = data.sessions.map(normalizeSessionRecord);
                            appState.bookmarks = Array.isArray(data.bookmarks) ? data.bookmarks : [];
                            appState.savedScriptures = Array.isArray(data.savedScriptures) ? data.savedScriptures : [];
                            appState.verseComments = Array.isArray(data.verseComments) ? data.verseComments : [];
                            appState.calendarEvents = Array.isArray(data.calendarEvents) ? data.calendarEvents : [];
                            if (data.homeCustomization) appState.homeCustomization = { ...appState.homeCustomization, ...data.homeCustomization };
                            if (data.windowPrefs) appState.windowPrefs = { ...appState.windowPrefs, ...data.windowPrefs };

                            for (const s of appState.sessions) await saveSessionToIndexedDB(s);
                            if (Array.isArray(data.annotations)) {
                                await new Promise((resolve) => {
                                    const tx = db.transaction(STORE_ANNOTATIONS, 'readwrite');
                                    const store = tx.objectStore(STORE_ANNOTATIONS);
                                    data.annotations.forEach(ann => { if (ann && ann.sessionId) store.put(ann); });
                                    tx.oncomplete = () => resolve();
                                    tx.onerror = () => resolve();
                                });
                            }
                            if (Array.isArray(data.embeddedPdfFiles)) {
                                for (const f of data.embeddedPdfFiles) {
                                    if (!f || !f.fileId || !f.base64) continue;
                                    const buf = base64ToArrayBuffer(f.base64);
                                    await saveBinaryFileToIdb(f.fileId, new Blob([buf], { type: f.mimeType || 'application/pdf' }), f.fileName, f.mimeType || 'application/pdf');
                                }
                            }
                            if (Array.isArray(data.embeddedAudioFiles)) {
                                for (const f of data.embeddedAudioFiles) {
                                    if (!f || !f.fileId || !f.base64) continue;
                                    const buf = base64ToArrayBuffer(f.base64);
                                    await saveBinaryFileToIdb(f.fileId, new Blob([buf], { type: f.mimeType || 'audio/mpeg' }), f.fileName, f.mimeType || 'audio/mpeg');
                                }
                            }
                            if (data.embeddedBible && data.embeddedBible.base64) {
                                const bibleBuf = base64ToArrayBuffer(data.embeddedBible.base64);
                                loadedBibleArchive = await parseEpubArchive(bibleBuf, data.embeddedBible.fileName || 'Bibbia.epub');
                                await new Promise((resolve) => {
                                    const tx = db.transaction(STORE_BIBLE, 'readwrite');
                                    tx.objectStore(STORE_BIBLE).put(loadedBibleArchive);
                                    tx.oncomplete = () => resolve();
                                    tx.onerror = () => resolve();
                                });
                            }
                            await savePreferencesToIndexedDB();
                            updateBookmarksCountLabel();
                            applyHomeAppearanceUI();
                            updateNavigationUI();
                            if (fb) {
                                fb.classList.remove('hidden');
                                fb.textContent = '✅ Ripristino completato con successo!';
                            }
                        }
                    );
                } catch (_) {
                    if (fb) {
                        fb.classList.remove('hidden');
                        fb.textContent = 'Errore: il file selezionato non è un backup JSON valido.';
                    }
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        function openConfirmModal(title, message, onOk) {
            document.getElementById('confirm-modal-title').textContent = title;
            document.getElementById('confirm-modal-message').textContent = message;
            confirmCallback = onOk;
            document.getElementById('confirm-action-modal')?.classList.remove('hidden');
        }
        function closeConfirmModal() {
            confirmCallback = null;
            document.getElementById('confirm-action-modal')?.classList.add('hidden');
        }
        document.getElementById('btn-confirm-modal-ok')?.addEventListener('click', async () => {
            const fn = confirmCallback;
            closeConfirmModal();
            if (typeof fn === 'function') await fn();
        });

        function applyMeetingAndBarState() {
            document.body.classList.toggle('meeting-mode', appState.meetingMode);
            const lbl = document.getElementById('meeting-mode-label');
            if (lbl) lbl.textContent = appState.meetingMode ? '👁️ Adunanza: ON' : '👁️ Adunanza: OFF';
            document.getElementById('bottom-nav')?.classList.toggle('hidden-bar', appState.navCollapsed);
            document.getElementById('btn-restore-bottom-nav')?.classList.toggle('hidden', !appState.navCollapsed);
        }
        async function toggleMeetingMode() {
            appState.meetingMode = !appState.meetingMode;
            applyMeetingAndBarState();
            await savePreferencesToIndexedDB();
        }
        function toggleBottomBarVisibility(hide) {
            appState.navCollapsed = hide;
            applyMeetingAndBarState();
            if (appState.currentView === 'home') renderHomePage();
        }

        document.addEventListener('click', () => {
            document.getElementById('draw-color-dropdown-menu')?.classList.add('hidden');
        });

        window.addEventListener('resize', () => {
            if (appState.currentView === 'home') renderHomePage();
            else if (appState.currentView === 'detail' && activeSurfaceMode === 'pdf' && currentPdfDoc) renderPdfCanvasPage();
        });

        window.addEventListener('DOMContentLoaded', async () => {
            try {
                await loadAllFromIndexedDB();
                ensureHomeCardsInitialized();
                await loadSavedBibleArchiveFromIndexedDB();
                applyHomeAppearanceUI();
                applyMeetingAndBarState();
                applyTopbarFontSize();
                syncStrokeThicknessControls();
                updateDbStatus('Archivio locale attivo');
            } catch (err) {
                ensureHomeCardsInitialized();
                applyHomeAppearanceUI();
                applyMeetingAndBarState();
                applyTopbarFontSize();
                syncStrokeThicknessControls();
                updateDbStatus('Memoria temporanea', true);
            }
            bindPdfCanvasPointerEvents();
            selectDrawTool('pen');
            bindFloatingWindowInteractions('floating-notes-window', 'floating-notes-header', 'notesPanel');
            bindFloatingWindowInteractions('floating-bible-window', 'floating-bible-header', 'biblePanel');
            bindFloatingWindowInteractions('floating-video-window', 'floating-video-header', 'videoWindow');
            bindFloatingWindowInteractions('floating-audio-window', 'floating-audio-header', 'audioWindow');
            setupVideoControlsListeners();
            setupAudioControlsListeners();
            updateNavigationUI();
        });
    </script>
</body>
</html>
