           ===================================================================== */
        function openGlobalSearchModal() {
            const modal = document.getElementById('global-search-modal');
            const inp = document.getElementById('input-global-search');
            modal?.classList.remove('hidden');
            if (inp) {
                inp.value = '';
                setTimeout(() => inp.focus(), 30);
            }
            document.getElementById('global-search-results').innerHTML =
                `<div class="empty-state-box">Digita almeno 2 lettere per cercare tra note, scritture salvate, commenti, segnalibri e calendario.</div>`;
        }

        function closeGlobalSearchModal() {
            document.getElementById('global-search-modal')?.classList.add('hidden');
        }

        function runGlobalSearch(rawQuery) {
            const box = document.getElementById('global-search-results');
            if (!box) return;
            const q = (rawQuery || '').trim().toLowerCase();
            if (q.length < 2) {
                box.innerHTML = `<div class="empty-state-box">Digita almeno 2 lettere per cercare in tutto il quaderno.</div>`;
                return;
            }

            const results = [];

            // 1. Cerca nelle note delle sessioni
            appState.sessions.forEach(sess => {
                (sess.keyboardNotes || []).forEach(note => {
                    const plainContent = (note.content || '').replace(/<[^>]*>/g, ' ');
                    if ((note.title || '').toLowerCase().includes(q) || plainContent.toLowerCase().includes(q)) {
                        results.push({
                            badge: `📝 Nota in «${sess.title}»`,
                            title: note.title || 'Nota',
                            snippet: plainContent.trim().slice(0, 110),
                            action: () => {
                                closeGlobalSearchModal();
                                openSessionDetail(sess.id);
                                appState.windowPrefs.notesPanel.isOpen = true;
                                restoreAllFloatingWindows();
                            }
                        });
                    }
                });
            });

            // 2. Cerca nelle scritture salvate e commenti
            appState.savedScriptures.forEach(scr => {
                if ((scr.ref || '').toLowerCase().includes(q) || (scr.text || '').toLowerCase().includes(q)) {
                    results.push({
                        badge: '🔖 Scrittura salvata',
                        title: scr.ref,
                        snippet: (scr.text || '').slice(0, 110),
                        action: async () => {
                            closeGlobalSearchModal();
                            await openSavedScripturesFromHome();
                            openSavedScriptureDetail(scr.ref);
                        }
                    });
                }
            });

            appState.verseComments.forEach(vc => {
                if ((vc.ref || '').toLowerCase().includes(q) || (vc.text || '').toLowerCase().includes(q)) {
                    results.push({
                        badge: `💬 Commento a ${vc.ref}`,
                        title: vc.ref,
                        snippet: (vc.text || '').slice(0, 110),
                        action: async () => {
                            closeGlobalSearchModal();
                            await openSavedScripturesFromHome();
                            openSavedScriptureDetail(vc.ref);
                        }
                    });
                }
            });

            // 3. Cerca nei segnalibri
            appState.bookmarks.forEach(bm => {
                if ((bm.title || '').toLowerCase().includes(q)) {
                    results.push({
                        badge: `🔖 Segnalibro (Pag. ${bm.page})`,
                        title: bm.title,
                        snippet: 'Tocca per tornare alla pagina contrassegnata',
                        action: () => {
                            closeGlobalSearchModal();
                            goToBookmark(bm.id);
                        }
                    });
                }
            });

            // 4. Cerca negli appuntamenti del calendario
            appState.calendarEvents.forEach(ev => {
                if ((ev.title || '').toLowerCase().includes(q) || (ev.notes || '').toLowerCase().includes(q)) {
                    results.push({
                        badge: `📅 Calendario (${formatHumanDate(ev.date)})`,
                        title: ev.title,
                        snippet: ev.notes || getCategoryLabel(ev.category),
                        action: () => {
                            closeGlobalSearchModal();
                            calendarSelectedIsoDate = ev.date;
                            calendarCursorDate = new Date(ev.date + 'T00:00:00');
                            openCalendarView();
                        }
                    });
                }
            });

            if (!results.length) {
                box.innerHTML = `<div class="empty-state-box">Nessun risultato trovato per «${escapeHtml(rawQuery)}».</div>`;
                return;
            }

            box.innerHTML = results.map((r, i) => `
                <button type="button" class="search-result-card" onclick="executeGlobalSearchResult(${i})">
                    <span class="tag-pill" style="align-self:flex-start;">${escapeHtml(r.badge)}</span>
                    <strong style="color:var(--plum-dark); font-size:0.9rem;">${escapeHtml(r.title)}</strong>
                    ${r.snippet ? `<span style="font-size:0.78rem; color:var(--text-muted);">${escapeHtml(r.snippet)}</span>` : ''}
                </button>
            `).join('');
            window._currentGlobalSearchResults = results;
        }

        function executeGlobalSearchResult(idx) {
            const item = window._currentGlobalSearchResults && window._currentGlobalSearchResults[idx];
            if (item && typeof item.action === 'function') item.action();
        }

        /* =====================================================================
           4. ESPORTAZIONE / STAMPA PDF DEI FOGLI A RIGHE E DELLE NOTE
           ===================================================================== */
        function exportLinedSheetsToPdf() {
            const sess = getActiveSession();
            const title = sess ? sess.title : 'Fogli a righe';
            const pages = activeSessionRecord.linedPages || [];
            if (!pages.length) return;

            const imagesHtml = pages.map((pg, idx) => {
                const offCanvas = document.createElement('canvas');
                offCanvas.width = LINED_W * 2;
                offCanvas.height = LINED_H * 2;
                const ctx = offCanvas.getContext('2d');
                ctx.scale(2, 2);

                // Sfondo foglio avorio + righe
                ctx.fillStyle = '#FFFDF9';
                ctx.fillRect(0, 0, LINED_W, LINED_H);
                ctx.strokeStyle = 'rgba(138, 114, 130, 0.30)';
                ctx.lineWidth = 1;
                for (let y = 74; y < LINED_H - 20; y += 32) {
                    ctx.beginPath();
                    ctx.moveTo(0, y);
                    ctx.lineTo(LINED_W, y);
                    ctx.stroke();
                }
                ctx.strokeStyle = 'rgba(168, 85, 118, 0.42)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(54, 0);
                ctx.lineTo(54, LINED_H);
                ctx.stroke();

                renderStrokesOnCanvas(ctx, pg.strokes || [], LINED_W, LINED_H, null);
                const dataUrl = offCanvas.toDataURL('image/png');
                return `
                    <div class="print-page">
                        <div class="print-header">${escapeHtml(title)} — Pagina ${idx + 1} di ${pages.length}</div>
                        <img src="${dataUrl}" alt="Foglio ${idx + 1}">
                    </div>
                `;
            }).join('');

            openPrintWindow(title, imagesHtml, true);
        }

        function exportSingleNoteToPdf(noteId) {
