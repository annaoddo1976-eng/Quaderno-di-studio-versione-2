<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <title>Quaderno per lo studio (v2)</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" crossorigin="anonymous"></script>
    <style>
        :root {
            --bg-ivory: #FAF7F2;
            --surface-card: #FFFFFF;
            --surface-soft: #F7F1F5;
            --plum: #6B2D5C;
            --plum-dark: #4E1E42;
            --burgundy: #88294B;
            --rose-soft: #F5E6EE;
            --rose-border: #DFC2D2;
            --gold-accent: #C8A25E;
            --text-main: #2A1924;
            --text-muted: #6F5967;
            --border-light: #E6D8E0;
            --shadow-soft: 0 6px 18px -8px rgba(78, 30, 66, 0.16);
            --nav-height: 56px;
            --sidebar-width: 248px;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100dvh;
            background-color: var(--bg-ivory);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
        }

        body.is-home-view {
            touch-action: pan-x pan-y;
            overscroll-behavior: none;
        }

        .app-shell {
            display: flex;
            flex-direction: row;
            width: 100%;
            height: 100dvh;
            background-color: #FAF5F4;
            position: relative;
            overflow: hidden;
        }

        /* BARRA LATERALE RICHIUDIBILE */
        .app-sidebar {
            flex: 0 0 var(--sidebar-width);
            width: var(--sidebar-width);
            height: 100%;
            background-color: #F4ECEB;
            border-right: 1px solid var(--rose-border);
            display: flex;
            flex-direction: column;
            z-index: 50;
            transition: margin-left 0.2s ease, transform 0.2s ease;
        }

        .app-sidebar.collapsed {
            margin-left: calc(-1 * var(--sidebar-width));
        }

        @media (max-width: 820px) {
            .app-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                margin-left: 0 !important;
                transform: translateX(0);
                box-shadow: 0 18px 40px -12px rgba(42, 25, 36, 0.35);
            }
            .app-sidebar.collapsed {
                transform: translateX(-100%);
            }
        }

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(42, 25, 36, 0.32);
            z-index: 45;
        }

        @media (min-width: 821px) {
            .sidebar-backdrop {
                display: none !important;
            }
        }

        .sidebar-brand {
            padding: 14px 16px 10px 16px;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-nav-scroll {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            padding: 4px 10px 14px 10px;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .sidebar-item {
            width: 100%;
            border: none;
            background: transparent;
            border-radius: 12px;
            padding: 9px 11px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: left;
            font-size: 0.86rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            transition: background-color 0.14s ease, color 0.14s ease;
        }

        .sidebar-item:hover {
            background-color: rgba(255, 255, 255, 0.65);
        }

        .sidebar-item.active {
            background-color: #EBDCE0;
            color: var(--plum-dark);
            font-weight: 700;
        }

        .sidebar-item-icon {
            width: 20px;
            text-align: center;
            font-size: 0.96rem;
            color: var(--plum);
            flex-shrink: 0;
        }

        .sidebar-divider {
            height: 1px;
            background-color: var(--rose-border);
            margin: 8px 6px;
        }

        .app-content-column {
            flex: 1 1 auto;
            min-width: 0;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background-color: #FAF5F4;
        }

        .app-header {
            flex: 0 0 auto;
            background: linear-gradient(135deg, #FDFBF8 0%, #F7ECF2 100%);
            border-bottom: 1.5px solid var(--rose-border);
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .hamburger-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid var(--rose-border);
            background-color: #FFFFFF;
            color: var(--plum-dark);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .hamburger-btn:hover {
            background-color: var(--rose-soft);
        }

        .header-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 11px;
            border-radius: 999px;
            background-color: var(--surface-card);
            border: 1px solid var(--rose-border);
            color: var(--plum);
            font-size: 0.76rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #2E7D5B;
        }

        .app-main {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            padding: 10px 14px 6px 14px;
            overflow: hidden;
            position: relative;
        }

        .app-main.studio-mode {
            padding: 0;
        }

        /* HOME PAGE */
        .home-container {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            width: 100%;
            margin: 0;
        }

        .home-editorial-hero {
            position: relative;
            border-radius: 20px;
            padding: 16px 20px;
            margin-bottom: 10px;
            background: linear-gradient(115deg, #F5E9EC 0%, #FAF4F3 58%, #EFE2E7 100%);
            border: 1px solid var(--rose-border);
            overflow: hidden;
            flex: 0 0 auto;
        }

        .home-hero-eyebrow {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 0 0 4px 0;
        }

        .home-hero-title {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(1.55rem, 3.2vw, 2.2rem);
            font-weight: 700;
            color: var(--plum-dark);
            line-height: 1.12;
        }

        .home-hero-subtitle {
            margin: 4px 0 10px 0;
            font-size: 0.86rem;
            color: var(--text-muted);
        }

        .home-hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        /* RIQUADRO RIEPILOGO HOME: PROSSIMO APPUNTAMENTO E ULTIME SCRITTURE SALVATE */
        .home-highlights-row {
            flex: 0 0 auto;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 10px;
        }

        @media (max-width: 720px) {
            .home-highlights-row {
                grid-template-columns: 1fr;
            }
        }

        .home-highlight-card {
            background-color: rgba(255, 255, 255, 0.96);
            border: 1px solid var(--rose-border);
            border-radius: 15px;
            padding: 10px 13px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            box-shadow: 0 3px 10px -6px rgba(78, 30, 66, 0.14);
        }

        .home-highlight-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--plum);
        }

        .home-highlight-body {
            font-size: 0.83rem;
            color: var(--text-main);
            line-height: 1.38;
        }

        .sections-grid-viewport {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            grid-auto-rows: minmax(88px, 1fr);
            gap: 12px;
            align-content: stretch;
            padding-bottom: 10px;
        }

        @media (max-width: 680px) {
            .sections-grid-viewport {
                grid-template-columns: 1fr;
                grid-auto-rows: minmax(76px, auto);
            }
        }

        .section-card {
            background-color: rgba(255, 255, 255, 0.96);
            border: 1.5px solid var(--border-light);
            border-radius: 18px;
            padding: 16px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            text-align: left;
            cursor: pointer;
            box-shadow: var(--shadow-soft);
            transition: transform 0.14s ease, border-color 0.14s ease, background-color 0.14s ease;
            min-height: 86px;
            height: 100%;
            width: 100%;
        }

        .section-card:hover,
        .section-card:focus-visible {
            border-color: var(--plum);
            background-color: #FFFDFC;
            outline: none;
            transform: translateY(-1px);
        }

        .section-card-left {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .section-badge {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background-color: #F4E8EC;
            color: var(--plum);
            border: 1px solid var(--rose-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.28rem;
            flex-shrink: 0;
        }

        .section-info {
            min-width: 0;
        }

        .section-title {
            margin: 0;
            font-size: clamp(1.12rem, 1.8vw, 1.3rem);
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.25;
            word-break: break-word;
        }

        .section-meta {
            margin: 4px 0 0 0;
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        .section-card-actions {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding-left: 8px;
            border-left: 1px solid var(--border-light);
            flex-shrink: 0;
        }

        .card-mini-btn {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.85rem;
        }

        .card-mini-btn:hover {
            background-color: var(--rose-soft);
            color: var(--plum-dark);
        }

        .card-mini-btn.danger:hover {
            background-color: #FDECEF;
            color: #9F203B;
        }

        /* PULSANTI */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border-radius: 9px;
            padding: 6px 10px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid transparent;
            transition: background-color 0.14s ease, border-color 0.14s ease, opacity 0.14s ease;
            line-height: 1.15;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .btn-primary {
            background-color: var(--plum);
            color: #FFFFFF;
        }

        .btn-primary:hover:not(:disabled) {
            background-color: var(--plum-dark);
        }

        .btn-soft {
            background-color: var(--rose-soft);
            color: var(--plum-dark);
            border-color: var(--rose-border);
        }

        .btn-soft:hover:not(:disabled) {
            background-color: #EDD7E4;
        }

        .btn-outline {
            background-color: var(--surface-card);
            color: var(--plum-dark);
            border-color: var(--rose-border);
        }

        .btn-outline:hover:not(:disabled) {
            background-color: var(--surface-soft);
        }

        .btn-danger {
            background-color: #FDF2F4;
            color: #9F203B;
            border-color: #F0C4CE;
        }

        .btn-icon-sm {
            padding: 5px 8px;
            font-size: 0.77rem;
        }

        /* =====================================================================
           VISTA CALENDARIO PERSONALE INTEGRATO (MENSILE + SETTIMANALE)
           ===================================================================== */
        .calendar-workspace {
            flex: 1 1 auto;
            min-height: 0;
            width: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
            overflow: hidden;
        }

        .calendar-topbar {
            flex: 0 0 auto;
            background: var(--surface-card);
            border: 1.5px solid var(--rose-border);
            border-radius: 16px;
            padding: 10px 14px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .calendar-main-layout {
            flex: 1 1 auto;
            min-height: 0;
            display: grid;
            grid-template-columns: 1.45fr 1fr;
            gap: 12px;
            overflow: hidden;
        }

        @media (max-width: 860px) {
            .calendar-main-layout {
                grid-template-columns: 1fr;
                overflow-y: auto;
            }
        }

        .calendar-grid-card {
            background: var(--surface-card);
            border: 1.5px solid var(--rose-border);
            border-radius: 16px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-height: 0;
            overflow-y: auto;
        }

        .calendar-weekdays-row {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 4px;
            text-align: center;
            font-size: 0.72rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .calendar-days-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 5px;
        }

        .calendar-day-cell {
            min-height: 62px;
            border-radius: 11px;
            border: 1px solid var(--border-light);
            background: var(--bg-ivory);
            padding: 5px 6px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            cursor: pointer;
            text-align: left;
            transition: border-color 0.14s ease, background-color 0.14s ease;
        }

        .calendar-day-cell:hover {
            border-color: var(--plum);
            background: #FFFFFF;
        }

        .calendar-day-cell.is-other-month {
            opacity: 0.45;
        }

        .calendar-day-cell.is-today {
            border-color: var(--burgundy);
            background: #FFF9EC;
        }

        .calendar-day-cell.is-selected {
            border: 2px solid var(--plum);
            background: var(--rose-soft);
        }

        .cal-day-num {
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .cal-dots-row {
            display: flex;
            flex-wrap: wrap;
            gap: 3px;
            margin-top: 4px;
        }

        .cal-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }

        .cal-cat-servizio { background-color: #6B2D5C; }
        .cal-cat-adunanza { background-color: #88294B; }
        .cal-cat-assemblea { background-color: #C8A25E; }
        .cal-cat-importante { background-color: #2E7D5B; }

        .calendar-side-column {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
            overflow-y: auto;
            padding-right: 2px;
        }

        .calendar-panel-box {
            background: var(--surface-card);
            border: 1.5px solid var(--rose-border);
            border-radius: 16px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .cal-event-item {
            background: var(--bg-ivory);
            border: 1px solid var(--border-light);
            border-left: 4px solid var(--plum);
            border-radius: 11px;
            padding: 8px 10px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 8px;
        }

        .cal-event-item[data-cat="adunanza"] { border-left-color: #88294B; }
        .cal-event-item[data-cat="assemblea"] { border-left-color: #C8A25E; }
        .cal-event-item[data-cat="importante"] { border-left-color: #2E7D5B; }

        .tag-pill {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            background-color: var(--rose-soft);
            color: var(--plum-dark);
            font-weight: 600;
            font-size: 0.73rem;
        }

        body.meeting-mode .admin-only {
            display: none !important;
        }

        /* =====================================================================
           BARRA SUPERIORE ORDINATA A RIGHE PIENE DA SINISTRA A DESTRA
           ===================================================================== */
        .studio-workspace {
            flex: 1 1 auto;
            min-height: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background-color: var(--bg-ivory);
        }

        .studio-topbar {
            flex: 0 0 auto;
            background-color: #FDFBF8;
            border-bottom: 1.5px solid var(--rose-border);
            padding: 6px 10px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            width: 100%;
            font-size: var(--topbar-font-size, 0.88rem);
            z-index: 20;
        }

        .studio-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 5px;
            flex: 1 1 auto;
        }

        .studio-session-title {
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 700;
            font-size: 1.05em;
            color: var(--plum-dark);
            flex: 1 1 auto;
            min-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding: 0 4px;
        }

        .segmented-box {
            display: inline-flex;
            background: var(--rose-soft);
            border: 1px solid var(--rose-border);
            border-radius: 9px;
            padding: 2px;
            gap: 2px;
        }

        .segmented-btn {
            border: none;
            background: transparent;
            color: var(--plum-dark);
            font-size: 0.94em;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 7px;
            cursor: pointer;
            white-space: nowrap;
        }

        .segmented-btn.active {
            background: var(--plum);
            color: #FFFFFF;
        }

        .tool-chip {
            border: 1px solid var(--rose-border);
            background-color: var(--surface-card);
            color: var(--plum-dark);
            border-radius: 9px;
            padding: 5px 9px;
            font-size: 0.96em;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            white-space: nowrap;
            flex: 1 1 auto;
        }

        .tool-chip.active {
            background-color: var(--plum);
            color: #FFFFFF;
            border-color: var(--plum);
        }

        .color-dropdown-wrap {
            position: relative;
            display: inline-flex;
            flex: 1 1 auto;
        }

        .color-dropdown-menu {
            position: absolute;
            top: calc(100% + 5px);
            left: 0;
            z-index: 60;
            background: var(--surface-card);
            border: 1.5px solid var(--plum);
            border-radius: 12px;
            padding: 8px;
            box-shadow: 0 12px 28px -8px rgba(42, 25, 36, 0.35);
            display: grid;
            grid-template-columns: repeat(4, 30px);
            gap: 7px;
        }

        .color-dropdown-menu.hidden {
            display: none !important;
        }

        .color-dot-btn {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 2px solid #FFFFFF;
            box-shadow: 0 0 0 1px rgba(42, 25, 36, 0.25);
            cursor: pointer;
            padding: 0;
            flex-shrink: 0;
        }

        .color-dot-btn.active {
            box-shadow: 0 0 0 2.5px var(--plum-dark);
            transform: scale(1.08);
        }

        .compact-select {
            border: 1px solid var(--rose-border);
            background-color: #FFFFFF;
            color: var(--text-main);
            border-radius: 9px;
            padding: 5px 7px;
            font-size: 0.95em;
            font-weight: 700;
            flex: 1 1 auto;
        }

        input.compact-select,
        textarea.form-input,
        input.form-input {
            font-size: 16px !important;
            touch-action: manipulation;
            -webkit-user-select: text;
            user-select: text;
        }

        .compact-page-input {
            border: 1px solid var(--rose-border);
            background-color: #FFFFFF;
            color: var(--text-main);
            border-radius: 8px;
            padding: 4px 5px;
            font-size: 0.96em;
            font-weight: 700;
            width: 50px;
            text-align: center;
        }

        /* STAGE PRINCIPALE */
        .studio-stage {
            position: relative;
            flex: 1 1 auto;
            min-height: 0;
            width: 100%;
            overflow: hidden;
            background-color: #EFEAE4;
        }

        .pdf-viewer-pane {
            position: absolute;
            inset: 0;
            overflow: auto;
            -webkit-overflow-scrolling: touch;
            padding: 4px 6px 8px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .pdf-canvas-stack {
            position: relative;
            background: #FFFFFF;
            box-shadow: 0 8px 26px -10px rgba(42, 25, 36, 0.35);
            border-radius: 4px;
            margin: 0 auto;
            flex-shrink: 0;
        }

