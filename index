            document.getElementById('bible-verse-action-bar')?.classList.add('hidden');
        }

        function formatBibleVerseRange(nums) {
            const sorted = [...nums].sort((a, b) => a - b);
            const ranges = [];
            let i = 0;
            while (i < sorted.length) {
                let j = i;
                while (j + 1 < sorted.length && sorted[j + 1] === sorted[j] + 1) j++;
                ranges.push(i === j ? String(sorted[i]) : `${sorted[i]}-${sorted[j]}`);
                i = j + 1;
            }
            return ranges.join(', ');
        }

        function syncSelectedBibleVersesUI() {
            document.querySelectorAll('.bible-verse-row').forEach(r => r.classList.remove('selected'));
            if (!loadedBibleArchive || !selectedBibleVerseNums.length) {
                selectedBibleVerseContext = null;
                document.getElementById('bible-verse-action-bar')?.classList.add('hidden');
                return;
            }
            const book = loadedBibleArchive.books[loadedBibleArchive.currentBookIdx];
            const chap = book && book.chapters[loadedBibleArchive.currentChapterIdx];
            if (!book || !chap) return;

            const chosen = chap.verses
                .filter(v => selectedBibleVerseNums.includes(v.num))
                .sort((a, b) => a.num - b.num);

            if (!chosen.length) {
                clearSelectedBibleVerses();
                return;
            }

            chosen.forEach(v => document.getElementById('bverse-' + v.num)?.classList.add('selected'));
            const rangeStr = formatBibleVerseRange(chosen.map(v => v.num));
            const combinedText = chosen.length === 1
                ? chosen[0].text
                : chosen.map(v => `${v.num} ${v.text}`).join(' ');

            selectedBibleVerseContext = {
                bookNum: book.num,
                bookName: book.name,
                chapterNum: chap.num,
                verseNum: chosen[0].num,
                verseNums: chosen.map(v => v.num),
                ref: `${book.name} ${chap.num}:${rangeStr}`,
                text: combinedText
            };
            document.getElementById('lbl-selected-bible-ref').textContent = selectedBibleVerseContext.ref;
            document.getElementById('bible-verse-action-bar')?.classList.remove('hidden');
        }

        function selectBibleVerse(vNum) {
            const book = loadedBibleArchive.books[loadedBibleArchive.currentBookIdx];
            const chap = book.chapters[loadedBibleArchive.currentChapterIdx];
            const verse = chap.verses.find(v => v.num === vNum);
            if (!verse) return;

            const idx = selectedBibleVerseNums.indexOf(vNum);
            if (idx >= 0) selectedBibleVerseNums.splice(idx, 1);
            else selectedBibleVerseNums.push(vNum);

            syncSelectedBibleVersesUI();
        }

