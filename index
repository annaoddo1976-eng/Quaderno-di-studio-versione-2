        .lined-sticky-bar {
            flex: 0 0 auto;
            background: #FDFBF8;
            border-bottom: 1px solid var(--rose-border);
            padding: 5px 12px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            z-index: 10;
        }

        .lined-pages-scroll {
            flex: 1 1 auto;
            min-height: 0;
            overflow: auto;
            -webkit-overflow-scrolling: touch;
            padding: 10px 10px 28px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
        }

        .lined-sheet {
            position: relative;
            background-color: #FFFDF9;
            background-image:
                linear-gradient(90deg, transparent 52px, rgba(168, 85, 118, 0.34) 52px, rgba(168, 85, 118, 0.34) 53.5px, transparent 53.5px),
                repeating-linear-gradient(to bottom, transparent 0px, transparent 31px, rgba(138, 114, 130, 0.24) 31px, rgba(138, 114, 130, 0.24) 32px);
            background-position: 0 0, 0 42px;
            border: 1.5px solid var(--rose-border);
            border-radius: 12px;
            box-shadow: 0 8px 24px -10px rgba(42, 25, 36, 0.22);
            overflow: hidden;
            flex-shrink: 0;
        }

        .lined-sheet-header {
            position: absolute;
            top: 8px;
            left: 62px;
            right: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            pointer-events: none;
            font-size: 0.74rem;
            color: var(--text-muted);
            font-weight: 700;
            z-index: 2;
        }

        /* FINESTRE GALLEGGIANTI INDIPENDENTI (NOTE, BIBBIA, VIDEO) */
        .floating-window {
            position: absolute;
            z-index: 35;
            background: #FDFBF8;
            border: 1.5px solid var(--plum);
            border-radius: 16px;
            box-shadow: 0 18px 46px -12px rgba(42, 25, 36, 0.42);
            display: flex;
            flex-direction: column;
            min-width: 260px;
            min-height: 220px;
            max-width: calc(100% - 10px);
            max-height: calc(100% - 10px);
            overflow: hidden;
        }

        .floating-window-header {
            flex: 0 0 auto;
            background: linear-gradient(135deg, var(--plum) 0%, var(--plum-dark) 100%);
            color: #FFFFFF;
            padding: 7px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            cursor: move;
            touch-action: none;
            user-select: none;
        }

        .floating-window-subbar {
            flex: 0 0 auto;
            background: #FFFFFF;
            border-bottom: 1px solid var(--rose-border);
            padding: 6px 10px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .floating-window-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .win-resize-left {
            position: absolute;
            top: 34px;
            bottom: 14px;
            left: 0;
            width: 8px;
            cursor: ew-resize;
            touch-action: none;
            z-index: 40;
        }

        .win-resize-right {
            position: absolute;
            top: 34px;
            bottom: 14px;
            right: 0;
            width: 8px;
            cursor: ew-resize;
            touch-action: none;
            z-index: 40;
        }

        .win-resize-bottom {
            position: absolute;
            left: 14px;
            right: 14px;
            bottom: 0;
            height: 8px;
            cursor: ns-resize;
            touch-action: none;
            z-index: 40;
        }

        .win-resize-corner-br {
            position: absolute;
            right: 0;
            bottom: 0;
            width: 18px;
            height: 18px;
            cursor: nwse-resize;
            touch-action: none;
            z-index: 42;
            background: linear-gradient(135deg, transparent 48%, var(--plum) 48%);
            border-bottom-right-radius: 14px;
        }

        .win-resize-corner-bl {
            position: absolute;
            left: 0;
            bottom: 0;
            width: 18px;
            height: 18px;
            cursor: nesw-resize;
            touch-action: none;
            z-index: 42;
            background: linear-gradient(225deg, transparent 48%, var(--plum) 48%);
            border-bottom-left-radius: 14px;
        }

        /* NOTE */
        .note-card {
            background: #FFFFFF;
            border: 1.5px solid var(--border-light);
            border-radius: 14px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .note-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .note-title-text {
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 700;
            font-size: 0.94rem;
            color: var(--plum-dark);
            word-break: break-word;
            flex: 1 1 auto;
            min-width: 0;
        }

        .note-tools-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px;
            padding-top: 4px;
            border-top: 1px solid var(--border-light);
        }

        .note-editor-area {
            min-height: 76px;
            border: 1px solid var(--rose-border);
            border-radius: 10px;
            padding: 8px 10px;
            background: var(--bg-ivory);
            color: var(--text-main);
            line-height: 1.55;
            outline: none;
            word-break: break-word;
            white-space: pre-wrap;
        }

        .note-editor-area:focus {
            background: #FFFFFF;
            border-color: var(--plum);
        }

        .note-editor-area:empty:before {
            content: attr(data-placeholder);
            color: #9A8492;
            pointer-events: none;
        }

        /* BIBBIA */
        .bible-verse-row {
            padding: 6px 8px;
            border-radius: 10px;
            cursor: pointer;
            line-height: 1.65;
            transition: background-color 0.12s ease;
            word-break: normal;
            overflow-wrap: break-word;
        }

        .bible-verse-row:hover {
            background-color: var(--surface-soft);
        }

        .bible-verse-row.selected {
            background-color: #FFF4D6;
            border: 1px solid #E6C77A;
        }

        .bible-verse-num {
            font-weight: 800;
            color: var(--burgundy);
            margin-right: 5px;
        }

        /* VIDEO 16:9 */
        .video-16x9-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000000;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin: auto;
        }

        .video-16x9-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #000000;
        }

        /* BARRA INFERIORE */
        .bottom-nav {
            flex: 0 0 auto;
            height: var(--nav-height);
            background-color: #FDFBF8;
            border-top: 1.5px solid var(--rose-border);
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 4px 8px;
            gap: 4px;
            z-index: 25;
            overflow-x: auto;
        }

        .bottom-nav.hidden-bar {
            display: none !important;
        }

        .show-bar-floating-pill {
            position: fixed;
            right: 10px;
            bottom: 8px;
            z-index: 45;
            background: rgba(253, 251, 248, 0.95);
            border: 1px solid var(--rose-border);
            color: var(--plum-dark);
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(42, 25, 36, 0.18);
            cursor: pointer;
        }

        .nav-item-btn {
            background: transparent;
            border: 1px solid transparent;
            border-radius: 11px;
            padding: 6px 11px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }

        .nav-item-btn.active {
            background-color: var(--rose-soft);
            color: var(--plum-dark);
            border-color: var(--rose-border);
        }

        /* MODALI */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background-color: rgba(42, 25, 36, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 60;
        }

        .modal-backdrop.hidden {
            display: none !important;
        }

        #confirm-action-modal {
            z-index: 95;
        }

        .modal-card {
            background-color: var(--surface-card);
            border: 1.5px solid var(--rose-border);
            border-radius: 18px;
            max-width: 480px;
            width: 100%;
            max-height: 88dvh;
            overflow-y: auto;
            padding: 18px;
            box-shadow: 0 18px 40px -12px rgba(42, 25, 36, 0.35);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .modal-title {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.12rem;
            color: var(--plum-dark);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--plum-dark);
        }

        .form-input {
            width: 100%;
            padding: 9px 11px;
            border-radius: 10px;
            border: 1.5px solid var(--rose-border);
            background-color: var(--bg-ivory);
            color: var(--text-main);
            font-size: 0.9rem;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 4px;
        }

        .empty-state-box {
            background: var(--surface-card);
            border: 1.5px dashed var(--rose-border);
            border-radius: 16px;
            padding: 20px 14px;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* RISULTATI RICERCA GLOBALE */
        .search-result-card {
            background: var(--bg-ivory);
            border: 1px solid var(--rose-border);
            border-radius: 12px;
