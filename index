                if (loadedBibleArchive.currentBookIdx !== exact.i) {
                    loadedBibleArchive.currentBookIdx = exact.i;
                    loadedBibleArchive.currentChapterIdx = 0;
                    renderBibleWindowContent();
                    const updatedSel = document.getElementById('bible-book-select');
                    if (updatedSel) {
