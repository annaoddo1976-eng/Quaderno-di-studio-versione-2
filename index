        function syncStrokeThicknessControls() {
            const slider = document.getElementById('input-stroke-slider');
            const lbl = document.getElementById('lbl-stroke-px');
            const val = activeDrawTool === 'highlighter' ? highlighterStrokeThickness : penStrokeThickness;
            if (slider) {
                slider.min = activeDrawTool === 'highlighter' ? '3' : '0.3';
                slider.max = activeDrawTool === 'highlighter' ? '36' : '12';
                slider.step = activeDrawTool === 'highlighter' ? '1' : '0.1';
                slider.value = String(val);
            }
            if (lbl) {
                lbl.textContent = activeDrawTool === 'highlighter' ? Math.round(val) + 'px' : Number(val).toFixed(1);
            }
        }

        function applyThicknessPreset(levelIdx) {
            const idx = Math.max(0, Math.min(2, parseInt(levelIdx, 10) || 0));
            if (activeDrawTool === 'highlighter') highlighterStrokeThickness = HIGHLIGHTER_THICKNESS_LEVELS[idx];
            else penStrokeThickness = PEN_THICKNESS_LEVELS[idx];
            syncStrokeThicknessControls();
        }

        function setCustomStrokeThickness(rawVal) {
            const num = parseFloat(rawVal);
            if (!Number.isFinite(num)) return;
            if (activeDrawTool === 'highlighter') highlighterStrokeThickness = Math.max(3, Math.min(36, num));
            else penStrokeThickness = Math.max(0.3, Math.min(12, num));
            syncStrokeThicknessControls();
        }

        function getActiveStrokeWidth() {
            return activeDrawTool === 'highlighter' ? highlighterStrokeThickness : penStrokeThickness;
        }

        function selectDrawTool(tool) {
            activeDrawTool = tool;
            ['hand', 'pen', 'highlighter', 'eraser'].forEach(t => {
                document.getElementById('tool-' + t)?.classList.toggle('active', activeDrawTool === t);
            });
            const sel = document.getElementById('select-thickness-preset');
            if (sel) {
                sel.options[0].text = activeDrawTool === 'highlighter' ? 'Evid. Sottile' : 'Sottile (0.4)';
                sel.options[1].text = activeDrawTool === 'highlighter' ? 'Evid. Medio' : 'Medio (1.4)';
                sel.options[2].text = activeDrawTool === 'highlighter' ? 'Evid. Largo' : 'Spesso (3.2)';
            }
            syncStrokeThicknessControls();
            const pdfCanvas = document.getElementById('pdf-annotation-canvas');
            const pdfPane = document.getElementById('pdf-viewer-pane');
            const isHand = activeDrawTool === 'hand';
            if (pdfCanvas) {
                pdfCanvas.style.pointerEvents = isHand ? 'none' : 'auto';
                pdfCanvas.style.touchAction = isHand ? 'auto' : 'none';
            }
            if (pdfPane) {
                pdfPane.style.overflow = isHand ? 'auto' : 'hidden';
