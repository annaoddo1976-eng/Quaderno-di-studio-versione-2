        function bindFloatingWindowInteractions(winId, headerId, prefKey) {
            const win = document.getElementById(winId);
            const header = document.getElementById(headerId);
            const stage = document.getElementById('studio-stage');
            if (!win || !header || !stage) return;

            let drag = false, sx = 0, sy = 0, ol = 0, ot = 0;
            header.addEventListener('pointerdown', (e) => {
                if (e.target.closest('button, label, input')) return;
                e.preventDefault();
                drag = true;
                sx = e.clientX; sy = e.clientY;
                ol = win.offsetLeft; ot = win.offsetTop;
                try { header.setPointerCapture(e.pointerId); } catch (_) {}
            });
            header.addEventListener('pointermove', (e) => {
                if (!drag) return;
                win.style.left = Math.max(4, Math.min(stage.clientWidth - win.offsetWidth - 4, ol + (e.clientX - sx))) + 'px';
                win.style.top = Math.max(4, Math.min(stage.clientHeight - win.offsetHeight - 4, ot + (e.clientY - sy))) + 'px';
            });
            const endDrag = async () => {
                if (!drag) return;
                drag = false;
                appState.windowPrefs[prefKey].left = win.offsetLeft;
                appState.windowPrefs[prefKey].top = win.offsetTop;
                await savePreferencesToIndexedDB();
            };
            header.addEventListener('pointerup', endDrag);
            header.addEventListener('pointercancel', endDrag);

            win.querySelectorAll('[data-resize]').forEach(h => {
                let res = false, dir = h.dataset.resize, rx = 0, ry = 0, rl = 0, rw = 0, rh = 0;
                h.addEventListener('pointerdown', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    res = true;
                    rx = e.clientX; ry = e.clientY;
                    rl = win.offsetLeft; rw = win.offsetWidth; rh = win.offsetHeight;
                    try { h.setPointerCapture(e.pointerId); } catch (_) {}
                });
                h.addEventListener('pointermove', (e) => {
                    if (!res) return;
                    const dx = e.clientX - rx, dy = e.clientY - ry;
                    if (dir.includes('right')) win.style.width = Math.max(260, Math.min(stage.clientWidth - rl - 6, rw + dx)) + 'px';
                    if (dir.includes('left')) {
                        const cdx = Math.max(-rl + 6, Math.min(rw - 260, dx));
                        win.style.left = (rl + cdx) + 'px';
                        win.style.width = (rw - cdx) + 'px';
                    }
                    if (dir.includes('bottom')) win.style.height = Math.max(220, Math.min(stage.clientHeight - win.offsetTop - 6, rh + dy)) + 'px';
                });
                const endRes = async () => {
                    if (!res) return;
                    res = false;
                    appState.windowPrefs[prefKey].left = win.offsetLeft;
                    appState.windowPrefs[prefKey].width = win.offsetWidth;
                    appState.windowPrefs[prefKey].height = win.offsetHeight;
                    await savePreferencesToIndexedDB();
                };
                h.addEventListener('pointerup', endRes);
                h.addEventListener('pointercancel', endRes);
            });
        }

