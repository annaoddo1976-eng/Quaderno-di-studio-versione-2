        async function saveCalendarEventForm() {
            const title = (document.getElementById('input-cal-event-title').value || '').trim();
            const date = document.getElementById('input-cal-event-date').value || calendarSelectedIsoDate;
            const category = document.getElementById('select-cal-event-cat').value || 'servizio';
            const startTime = document.getElementById('input-cal-event-start').value || '';
            const endTime = document.getElementById('input-cal-event-end').value || '';
            const notes = (document.getElementById('textarea-cal-event-notes').value || '').trim();

            if (!title) {
                document.getElementById('input-cal-event-title')?.focus();
                return;
            }

            if (editingCalendarEventId) {
                const ev = appState.calendarEvents.find(e => e.id === editingCalendarEventId);
                if (ev) {
                    ev.title = title;
                    ev.date = date;
                    ev.category = category;
                    ev.startTime = startTime;
                    ev.endTime = endTime;
                    ev.notes = notes;
                }
            } else {
                appState.calendarEvents.push({
                    id: 'cal_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5),
                    title,
                    date,
                    category,
                    startTime,
                    endTime,
                    notes
                });
            }

            calendarSelectedIsoDate = date;
            await savePreferencesToIndexedDB();
            closeEventFormModal();
            renderCalendarView();
            renderHomeHighlights();
        }

