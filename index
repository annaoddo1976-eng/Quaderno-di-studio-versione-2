        async function renderPdfCanvasPage() {
            const empty = document.getElementById('pdf-empty-card');
            const stack = document.getElementById('pdf-canvas-stack');
            const gotoInp = document.getElementById('pdf-goto-input');
            const totLbl = document.getElementById('pdf-pages-total-label');
            const zoomLbl = document.getElementById('pdf-zoom-pct-label');

            document.getElementById('btn-fit-page')?.classList.toggle('active', currentPdfFitMode === 'page');
            document.getElementById('btn-fit-width')?.classList.toggle('active', currentPdfFitMode === 'width');

            if (!currentPdfDoc) {
                empty?.classList.remove('hidden');
                stack?.classList.add('hidden');
                if (gotoInp) gotoInp.value = 1;
                if (totLbl) totLbl.textContent = '/ 1';
                return;
            }

            empty?.classList.add('hidden');
            stack?.classList.remove('hidden');
            currentPdfPage = Math.max(1, Math.min(currentPdfTotalPages, currentPdfPage));
            if (gotoInp) gotoInp.value = currentPdfPage;
            if (totLbl) totLbl.textContent = `/ ${currentPdfTotalPages}`;

            if (activePdfRenderTask) {
                try { activePdfRenderTask.cancel(); } catch (_) {}
            }

            const pane = document.getElementById('pdf-viewer-pane');
            const rCanvas = document.getElementById('pdf-render-canvas');
            const aCanvas = document.getElementById('pdf-annotation-canvas');
            const page = await currentPdfDoc.getPage(currentPdfPage);
            const unscaled = page.getViewport({ scale: 1 });
            const availW = Math.max(260, pane.clientWidth - 14);
            const availH = Math.max(260, pane.clientHeight - 12);

            if (currentPdfFitMode === 'page') currentPdfScale = Math.min(availW / unscaled.width, availH / unscaled.height);
            else if (currentPdfFitMode === 'width') currentPdfScale = availW / unscaled.width;
            currentPdfScale = Math.max(0.3, Math.min(4.0, currentPdfScale));
            if (zoomLbl) zoomLbl.textContent = Math.round(currentPdfScale * 100) + '%';

            const vp = page.getViewport({ scale: currentPdfScale });
            const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
            pdfCssW = Math.round(vp.width);
            pdfCssH = Math.round(vp.height);

            stack.style.width = pdfCssW + 'px';
            stack.style.height = pdfCssH + 'px';
            rCanvas.width = Math.round(pdfCssW * dpr);
            rCanvas.height = Math.round(pdfCssH * dpr);
            rCanvas.style.width = pdfCssW + 'px';
            rCanvas.style.height = pdfCssH + 'px';
            aCanvas.width = Math.round(pdfCssW * dpr);
            aCanvas.height = Math.round(pdfCssH * dpr);
            aCanvas.style.width = pdfCssW + 'px';
            aCanvas.style.height = pdfCssH + 'px';

            const ctx = rCanvas.getContext('2d');
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const task = page.render({ canvasContext: ctx, viewport: vp });
            activePdfRenderTask = task;
            await task.promise;
            activePdfRenderTask = null;

            const sess = getActiveSession();
            if (sess) {
                sess.lastPdfPage = currentPdfPage;
                sess.pdfScale = currentPdfScale;
                sess.pdfFitMode = currentPdfFitMode;
                await saveSessionToIndexedDB(sess);
            }
            redrawPdfAnnotations();
        }

        function changePdfPage(d) {
            if (!currentPdfDoc) return;
            currentPdfPage = Math.max(1, Math.min(currentPdfTotalPages, currentPdfPage + d));
            document.getElementById('pdf-viewer-pane').scrollTop = 0;
            renderPdfCanvasPage();
        }
        function jumpToPdfPage(v) {
            if (!currentPdfDoc) return;
            const p = parseInt(v, 10);
            if (!Number.isFinite(p)) return;
            currentPdfPage = Math.max(1, Math.min(currentPdfTotalPages, p));
            renderPdfCanvasPage();
        }
        function changePdfZoom(d) {
            if (!currentPdfDoc) return;
            currentPdfFitMode = 'manual';
            currentPdfScale = Math.max(0.3, Math.min(4.0, currentPdfScale + d));
            renderPdfCanvasPage();
        }
        function setPdfFitMode(m) {
            currentPdfFitMode = m;
            renderPdfCanvasPage();
        }

        function hexToRgba(hex, alpha) {
            const c = (hex || '#FACC15').replace('#', '');
            if (c.length !== 6) return `rgba(250, 204, 21, ${alpha})`;
            return `rgba(${parseInt(c.slice(0, 2), 16)}, ${parseInt(c.slice(2, 4), 16)}, ${parseInt(c.slice(4, 6), 16)}, ${alpha})`;
        }

        function renderStrokesOnCanvas(ctx, strokes, cssW, cssH, live = null) {
            const list = live ? [...strokes, live] : strokes;
            list.forEach(st => {
                const pts = st.points || [];
                if (pts.length === 0) return;
                ctx.save();
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                const baseWidth = Number(st.width) || 0.4;
                const scaledW = st.tool === 'highlighter'
                    ? Math.max(3, baseWidth * (cssW / 760))
                    : Math.max(0.55, baseWidth * (cssW / 760));
                if (st.tool === 'highlighter') {
                    ctx.globalCompositeOperation = 'multiply';
                    ctx.strokeStyle = hexToRgba(st.color, 0.36);
                    ctx.lineWidth = scaledW;
                } else {
                    ctx.globalCompositeOperation = 'source-over';
                    ctx.strokeStyle = st.color || '#2A1924';
                    ctx.lineWidth = scaledW;
                }
                ctx.beginPath();
                if (pts.length === 1) {
                    ctx.arc(pts[0].x * cssW, pts[0].y * cssH, Math.max(0.6, scaledW / 2), 0, Math.PI * 2);
                    ctx.fillStyle = ctx.strokeStyle;
                    ctx.fill();
                } else {
                    ctx.moveTo(pts[0].x * cssW, pts[0].y * cssH);
                    for (let i = 1; i < pts.length - 1; i++) {
                        const mx = ((pts[i].x + pts[i + 1].x) / 2) * cssW;
                        const my = ((pts[i].y + pts[i + 1].y) / 2) * cssH;
                        ctx.quadraticCurveTo(pts[i].x * cssW, pts[i].y * cssH, mx, my);
                    }
                    const last = pts[pts.length - 1];
                    ctx.lineTo(last.x * cssW, last.y * cssH);
                    ctx.stroke();
                }
                ctx.restore();
            });
        }

        function redrawPdfAnnotations(live = null) {
            const canvas = document.getElementById('pdf-annotation-canvas');
            if (!canvas || !pdfCssW || !pdfCssH) return;
            const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
            const ctx = canvas.getContext('2d');
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, pdfCssW, pdfCssH);
            const k = String(currentPdfPage);
            if (!Array.isArray(activeSessionRecord.pdfAnnotations[k])) activeSessionRecord.pdfAnnotations[k] = [];
            renderStrokesOnCanvas(ctx, activeSessionRecord.pdfAnnotations[k], pdfCssW, pdfCssH, live);
        }

        function bindPdfCanvasPointerEvents() {
            const canvas = document.getElementById('pdf-annotation-canvas');
            const pane = document.getElementById('pdf-viewer-pane');
            if (!canvas) return;
            let pid = null, pts = null;
            const getNorm = (e) => {
                const r = canvas.getBoundingClientRect();
                return {
                    x: Math.max(0, Math.min(1, (e.clientX - r.left) / Math.max(1, r.width))),
                    y: Math.max(0, Math.min(1, (e.clientY - r.top) / Math.max(1, r.height)))
                };
            };
            const eraseAt = (pt) => {
                const k = String(currentPdfPage);
                const arr = activeSessionRecord.pdfAnnotations[k] || [];
                const next = arr.filter(st => !(st.points || []).some(p => Math.hypot(p.x - pt.x, p.y - pt.y) < 0.025));
                if (next.length !== arr.length) {
                    activeSessionRecord.pdfAnnotations[k] = next;
                    redrawPdfAnnotations();
                    scheduleAnnotationsSave();
                }
            };
            const onStart = (e) => {
                if (activeDrawTool === 'hand' || !currentPdfDoc) return;
                if (pencilOnlyMode && e.pointerType === 'touch') return;
                if (pid !== null && pid !== e.pointerId) return;
                e.preventDefault();
                e.stopPropagation();
                pid = e.pointerId;
                if (pane) pane.style.overflow = 'hidden';
                try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
                const pt = getNorm(e);
                if (activeDrawTool === 'eraser') { eraseAt(pt); return; }
                pts = [pt];
                redrawPdfAnnotations({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: pts });
            };
            const onMove = (e) => {
                if (pid !== e.pointerId) return;
                e.preventDefault();
                e.stopPropagation();
                const events = typeof e.getCoalescedEvents === 'function' ? e.getCoalescedEvents() : [e];
                for (const ev of events) {
                    const pt = getNorm(ev);
                    if (activeDrawTool === 'eraser') { eraseAt(pt); return; }
                    if (pts) pts.push(pt);
                }
                if (pts) {
                    redrawPdfAnnotations({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: pts });
                }
            };
            const end = (e) => {
                if (pid !== e.pointerId) return;
                pid = null;
                if (pane && activeDrawTool === 'hand') pane.style.overflow = 'auto';
                if (pts && pts.length > 0 && activeDrawTool !== 'eraser') {
                    const k = String(currentPdfPage);
                    if (!Array.isArray(activeSessionRecord.pdfAnnotations[k])) activeSessionRecord.pdfAnnotations[k] = [];
                    activeSessionRecord.pdfAnnotations[k].push({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: [...pts] });
                    activeSessionRecord.pdfRedoStacks[k] = [];
                    pts = null;
                    redrawPdfAnnotations();
                    scheduleAnnotationsSave();
                } else pts = null;
            };
            canvas.addEventListener('pointerdown', onStart, { passive: false });
            canvas.addEventListener('pointermove', onMove, { passive: false });
            canvas.addEventListener('pointerup', end);
            canvas.addEventListener('pointercancel', end);
            canvas.addEventListener('touchstart', (e) => { if (activeDrawTool !== 'hand') e.preventDefault(); }, { passive: false });
            canvas.addEventListener('touchmove', (e) => { if (activeDrawTool !== 'hand') e.preventDefault(); }, { passive: false });
        }

        function undoStroke() {
            if (activeSurfaceMode === 'pdf') {
                const k = String(currentPdfPage);
                const arr = activeSessionRecord.pdfAnnotations[k] || [];
                if (!arr.length) return;
                if (!Array.isArray(activeSessionRecord.pdfRedoStacks[k])) activeSessionRecord.pdfRedoStacks[k] = [];
                activeSessionRecord.pdfRedoStacks[k].push(arr.pop());
                redrawPdfAnnotations();
                scheduleAnnotationsSave();
            } else {
                const pg = activeSessionRecord.linedPages[linedPageCurrent - 1];
                if (!pg || !pg.strokes.length) return;
                pg.redoStack.push(pg.strokes.pop());
                renderLinedPages();
                scheduleAnnotationsSave();
            }
        }

        function redoStroke() {
            if (activeSurfaceMode === 'pdf') {
                const k = String(currentPdfPage);
                const redo = activeSessionRecord.pdfRedoStacks[k] || [];
                if (!redo.length) return;
                activeSessionRecord.pdfAnnotations[k].push(redo.pop());
                redrawPdfAnnotations();
                scheduleAnnotationsSave();
            } else {
                const pg = activeSessionRecord.linedPages[linedPageCurrent - 1];
                if (!pg || !pg.redoStack || !pg.redoStack.length) return;
                pg.strokes.push(pg.redoStack.pop());
                renderLinedPages();
                scheduleAnnotationsSave();
            }
        }

        /* =====================================================================
           FOGLI A RIGHE
           ===================================================================== */
        function renderLinedPages() {
            const scroll = document.getElementById('lined-pages-scroll');
            const pane = document.getElementById('lined-notebook-pane');
            const sess = getActiveSession();
            if (!scroll || !pane) return;

            const total = activeSessionRecord.linedPages.length;
            linedPageCurrent = Math.max(1, Math.min(total, linedPageCurrent));
            document.getElementById('lbl-lined-status').textContent = `Pagina ${linedPageCurrent} di ${total}`;
            document.getElementById('lbl-lined-zoom').textContent = `${Math.round(linedPageZoom * 100)}%`;

            const availW = Math.max(290, (pane.clientWidth || window.innerWidth) - 24);
            const ratio = Math.min(1.0, availW / LINED_W);
            const w = Math.round(LINED_W * ratio * linedPageZoom);
            const h = Math.round(LINED_H * ratio * linedPageZoom);

            scroll.innerHTML = activeSessionRecord.linedPages.map((pg, idx) => `
                <div class="lined-sheet" id="lined-sheet-${idx + 1}" style="width:${w}px; height:${h}px;">
                    <div class="lined-sheet-header">
                        <span>${escapeHtml(sess ? sess.title : '')}</span>
                        <span>Pagina ${idx + 1} di ${total}</span>
                    </div>
                    <canvas class="lined-sheet-canvas" id="lined-canvas-${idx}" style="width:${w}px; height:${h}px; touch-action:${activeDrawTool === 'hand' ? 'pan-y' : 'none'};"></canvas>
                </div>
            `).join('');

            activeSessionRecord.linedPages.forEach((pg, idx) => {
                const canvas = document.getElementById(`lined-canvas-${idx}`);
                if (!canvas) return;
                const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
                canvas.width = Math.round(w * dpr);
                canvas.height = Math.round(h * dpr);
                const redraw = (live = null) => {
                    const ctx = canvas.getContext('2d');
                    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                    ctx.clearRect(0, 0, w, h);
                    renderStrokesOnCanvas(ctx, pg.strokes, w, h, live);
                };
                redraw();

                let pid = null, pts = null;
                const getNorm = (e) => {
                    const r = canvas.getBoundingClientRect();
                    return {
                        x: Math.max(0, Math.min(1, (e.clientX - r.left) / Math.max(1, r.width))),
                        y: Math.max(0, Math.min(1, (e.clientY - r.top) / Math.max(1, r.height)))
                    };
                };
                canvas.addEventListener('pointerdown', (e) => {
                    if (activeDrawTool === 'hand') return;
                    if (pencilOnlyMode && e.pointerType === 'touch') return;
                    if (pid !== null && pid !== e.pointerId) return;
                    e.preventDefault();
                    pid = e.pointerId;
                    linedPageCurrent = idx + 1;
                    try { canvas.setPointerCapture(e.pointerId); } catch (_) {}
                    const pt = getNorm(e);
                    if (activeDrawTool === 'eraser') {
                        pg.strokes = pg.strokes.filter(st => !(st.points || []).some(p => Math.hypot(p.x - pt.x, p.y - pt.y) < 0.025));
                        redraw();
                        scheduleAnnotationsSave();
                        return;
                    }
                    pts = [pt];
                    redraw({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: pts });
                }, { passive: false });
                canvas.addEventListener('pointermove', (e) => {
                    if (pid !== e.pointerId) return;
                    e.preventDefault();
                    const events = typeof e.getCoalescedEvents === 'function' ? e.getCoalescedEvents() : [e];
                    for (const ev of events) {
                        const pt = getNorm(ev);
                        if (activeDrawTool === 'eraser') {
                            pg.strokes = pg.strokes.filter(st => !(st.points || []).some(p => Math.hypot(p.x - pt.x, p.y - pt.y) < 0.025));
                            redraw();
                            scheduleAnnotationsSave();
                            return;
                        }
                        if (pts) pts.push(pt);
                    }
                    if (pts) {
                        redraw({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: pts });
                    }
                }, { passive: false });
                const end = (e) => {
                    if (pid !== e.pointerId) return;
                    pid = null;
                    if (pts && pts.length > 0 && activeDrawTool !== 'eraser') {
                        pg.strokes.push({ tool: activeDrawTool, color: activeDrawColor, width: getActiveStrokeWidth(), points: pts });
                        pg.redoStack = [];
                        pts = null;
                        redraw();
                        scheduleAnnotationsSave();
                    } else pts = null;
                };
                canvas.addEventListener('pointerup', end);
                canvas.addEventListener('pointercancel', end);
            });
        }

