        function openPrintWindow(docTitle, innerHtml, isSheet) {
            const win = window.open('', '_blank');
            if (!win) {
                alert('Consenti l’apertura della finestra di stampa del browser per salvare il PDF.');
                return;
            }
            win.document.write(`<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<title>${escapeHtml(docTitle)}</title>
<style>
    body { font-family: Georgia, serif; margin: 0; padding: ${isSheet ? '0' : '24px'}; color: #2A1924; background: #FFFFFF; }
    .print-page { page-break-after: always; padding: 12mm; text-align: center; }
    .print-header { font-size: 11pt; color: #6B2D5C; font-weight: bold; margin-bottom: 6mm; text-align: left; }
    .print-page img { width: 100%; max-width: 185mm; border: 1px solid #DFC2D2; border-radius: 6px; }
    .note-print-box h1 { color: #4E1E42; margin: 0 0 6px 0; font-size: 20pt; }
    .note-print-box .meta { color: #6F5967; font-size: 10pt; margin-bottom: 16px; border-bottom: 1px solid #DFC2D2; padding-bottom: 8px; }
    .note-print-box .content { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.65; white-space: pre-wrap; }
</style>
</head>
<body>${innerHtml}</body>
</html>`);
            win.document.close();
            setTimeout(() => { win.focus(); win.print(); }, 350);
        }

