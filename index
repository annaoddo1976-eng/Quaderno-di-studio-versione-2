        function setCalendarViewMode(mode) {
            calendarViewMode = mode === 'week' ? 'week' : 'month';
            document.getElementById('btn-cal-mode-month')?.classList.toggle('active', calendarViewMode === 'month');
            document.getElementById('btn-cal-mode-week')?.classList.toggle('active', calendarViewMode === 'week');
            renderCalendarView();
        }

        function stepCalendarPeriod(delta) {
            const d = new Date(calendarCursorDate);
            if (calendarViewMode === 'week') {
                d.setDate(d.getDate() + delta * 7);
            } else {
                d.setMonth(d.getMonth() + delta);
            }
            calendarCursorDate = d;
            renderCalendarView();
        }

        function goToCalendarToday() {
            const now = new Date();
            calendarCursorDate = now;
            calendarSelectedIsoDate = toIsoDateStr(now);
            renderCalendarView();
        }

        function toIsoDateStr(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function formatHumanDate(isoStr) {
            if (!isoStr) return '';
            const d = new Date(isoStr + 'T00:00:00');
            return d.toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        }

        function getCategoryLabel(cat) {
            if (cat === 'adunanza') return 'Adunanze / Parti';
            if (cat === 'assemblea') return 'Assemblee';
            if (cat === 'importante') return 'Importante';
            return 'Servizio di campo';
        }

        function renderCalendarView() {
            const grid = document.getElementById('calendar-days-grid');
            const periodLbl = document.getElementById('lbl-calendar-period');
            if (!grid || !periodLbl) return;

            const todayIso = toIsoDateStr(new Date());
            let cells = [];

            if (calendarViewMode === 'week') {
                const base = new Date(calendarCursorDate);
                const dayOfWeek = (base.getDay() + 6) % 7; // Lunedì = 0
                const monday = new Date(base);
                monday.setDate(base.getDate() - dayOfWeek);
                const sunday = new Date(monday);
                sunday.setDate(monday.getDate() + 6);

                periodLbl.textContent = `${monday.getDate()} ${monday.toLocaleDateString('it-IT', { month: 'short' })} – ${sunday.getDate()} ${sunday.toLocaleDateString('it-IT', { month: 'short', year: 'numeric' })}`;

                for (let i = 0; i < 7; i++) {
                    const cur = new Date(monday);
                    cur.setDate(monday.getDate() + i);
                    cells.push({ date: cur, isOtherMonth: false });
                }
            } else {
                const year = calendarCursorDate.getFullYear();
                const month = calendarCursorDate.getMonth();
                const monthName = new Date(year, month, 1).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
                periodLbl.textContent = monthName.charAt(0).toUpperCase() + monthName.slice(1);

                const firstDay = new Date(year, month, 1);
                const startOffset = (firstDay.getDay() + 6) % 7;
                const gridStart = new Date(year, month, 1 - startOffset);

                for (let i = 0; i < 42; i++) {
                    const cur = new Date(gridStart);
                    cur.setDate(gridStart.getDate() + i);
                    cells.push({ date: cur, isOtherMonth: cur.getMonth() !== month });
                }
            }

            grid.innerHTML = cells.map(({ date, isOtherMonth }) => {
                const iso = toIsoDateStr(date);
                const dayEvents = appState.calendarEvents.filter(ev => ev.date === iso);
                const isToday = iso === todayIso;
                const isSelected = iso === calendarSelectedIsoDate;
                return `
                    <button type="button" class="calendar-day-cell ${isOtherMonth ? 'is-other-month' : ''} ${isToday ? 'is-today' : ''} ${isSelected ? 'is-selected' : ''}"
                        onclick="selectCalendarDay('${iso}')">
                        <span class="cal-day-num">${date.getDate()}</span>
                        <div class="cal-dots-row">
                            ${dayEvents.slice(0, 4).map(ev => `<span class="cal-dot cal-cat-${escapeHtml(ev.category || 'servizio')}" title="${escapeHtml(ev.title)}"></span>`).join('')}
                        </div>
                    </button>
                `;
            }).join('');

            renderSelectedDayAndUpcoming();
        }

        function selectCalendarDay(isoDate) {
            calendarSelectedIsoDate = isoDate;
            renderCalendarView();
        }

        function renderSelectedDayAndUpcoming() {
            const selHeading = document.getElementById('lbl-selected-day-heading');
            const selList = document.getElementById('selected-day-events-list');
            const upList = document.getElementById('upcoming-events-list');

            if (selHeading) selHeading.textContent = `Impegni: ${formatHumanDate(calendarSelectedIsoDate)}`;

            const dayEvents = appState.calendarEvents
                .filter(ev => ev.date === calendarSelectedIsoDate)
                .sort((a, b) => (a.startTime || '99:99').localeCompare(b.startTime || '99:99'));

            if (selList) {
                selList.innerHTML = !dayEvents.length
                    ? `<div class="empty-state-box" style="padding:14px;">Nessun appuntamento per questa giornata.</div>`
                    : dayEvents.map(ev => renderCalendarEventCard(ev)).join('');
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const inSevenDays = new Date(today);
            inSevenDays.setDate(today.getDate() + 7);
            const todayIso = toIsoDateStr(today);
            const maxIso = toIsoDateStr(inSevenDays);

            const upcoming = appState.calendarEvents
                .filter(ev => ev.date >= todayIso && ev.date <= maxIso)
                .sort((a, b) => (a.date + (a.startTime || '')).localeCompare(b.date + (b.startTime || '')));

            if (upList) {
                upList.innerHTML = !upcoming.length
                    ? `<div class="empty-state-box" style="padding:14px;">Nessun appuntamento nei prossimi 7 giorni.</div>`
                    : upcoming.map(ev => renderCalendarEventCard(ev, true)).join('');
            }
        }

        function formatIcsDateTime(isoDate, timeStr) {
            const d = (isoDate || '').replace(/-/g, '');
            if (!timeStr) return { value: d, isAllDay: true };
            const parts = timeStr.split(':');
            const hh = String(parts[0] || '09').padStart(2, '0');
            const mm = String(parts[1] || '00').padStart(2, '0');
            return { value: `${d}T${hh}${mm}00`, isAllDay: false };
        }

        function escapeIcsText(str) {
            return String(str || '')
                .replace(/\\/g, '\\\\')
                .replace(/;/g, '\\;')
                .replace(/,/g, '\\,')
                .replace(/\r?\n/g, '\\n');
        }

        function buildGoogleCalendarUrl(ev) {
            if (!ev || !ev.date) return 'https://calendar.google.com/calendar/render?action=TEMPLATE';
            const startObj = formatIcsDateTime(ev.date, ev.startTime);
            let datesParam = '';

            if (startObj.isAllDay) {
                const nextDay = new Date(ev.date + 'T00:00:00');
                nextDay.setDate(nextDay.getDate() + 1);
                const endIso = toIsoDateStr(nextDay).replace(/-/g, '');
                datesParam = `${startObj.value}/${endIso}`;
            } else {
                let endTime = ev.endTime;
                if (!endTime) {
                    const [hStr, mStr] = (ev.startTime || '09:00').split(':');
                    const endH = (parseInt(hStr, 10) + 1) % 24;
                    endTime = `${String(endH).padStart(2, '0')}:${String(mStr || '00').padStart(2, '0')}`;
                }
                const endObj = formatIcsDateTime(ev.date, endTime);
                datesParam = `${startObj.value}/${endObj.value}`;
            }

            const catLabel = getCategoryLabel(ev.category);
            const details = [catLabel, ev.notes || ''].filter(Boolean).join('\n');
            const params = new URLSearchParams({
                action: 'TEMPLATE',
                text: ev.title || 'Appuntamento',
                dates: datesParam,
                details
            });

            return `https://calendar.google.com/calendar/render?${params.toString()}`;
        }

        function exportCalendarEventToIcs(eventId) {
            const ev = appState.calendarEvents.find(e => e.id === eventId);
            if (!ev || !ev.date) return;

            const startObj = formatIcsDateTime(ev.date, ev.startTime);
            let dtStartLine = '';
            let dtEndLine = '';

            if (startObj.isAllDay) {
                const nextDay = new Date(ev.date + 'T00:00:00');
                nextDay.setDate(nextDay.getDate() + 1);
                const endIso = toIsoDateStr(nextDay).replace(/-/g, '');
                dtStartLine = `DTSTART;VALUE=DATE:${startObj.value}`;
                dtEndLine = `DTEND;VALUE=DATE:${endIso}`;
            } else {
                let endTime = ev.endTime;
                if (!endTime) {
                    const [hStr, mStr] = (ev.startTime || '09:00').split(':');
                    const endH = (parseInt(hStr, 10) + 1) % 24;
                    endTime = `${String(endH).padStart(2, '0')}:${String(mStr || '00').padStart(2, '0')}`;
                }
                const endObj = formatIcsDateTime(ev.date, endTime);
                dtStartLine = `DTSTART:${startObj.value}`;
                dtEndLine = `DTEND:${endObj.value}`;
            }

            const catLabel = getCategoryLabel(ev.category);
            const descParts = [catLabel];
            if (ev.notes) descParts.push(ev.notes);
            const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');

            const icsContent = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//Quaderno per lo studio//Calendario//IT',
                'CALSCALE:GREGORIAN',
                'METHOD:PUBLISH',
                'BEGIN:VEVENT',
                `UID:${ev.id}@quadernostudio`,
                `DTSTAMP:${stamp}`,
                dtStartLine,
                dtEndLine,
                `SUMMARY:${escapeIcsText(ev.title)}`,
                `DESCRIPTION:${escapeIcsText(descParts.join(' - '))}`,
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.target = '_blank';
            link.rel = 'noopener';
            const safeSlug = (ev.title || 'appuntamento').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '') || 'appuntamento';
            link.download = `${safeSlug}_${ev.date}.ics`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(() => URL.revokeObjectURL(url), 2500);
        }

